CHARGER_DATABASE_URL=jdbc:mysql://localhost:3306/tekwatt_chargers?serverTimezone=UTC
CONNECTOR_DATABASE_URL=jdbc:mysql://localhost:3306/tekwatt_connectors?serverTimezone=UTC
CHARGING_SESSION_DATABASE_URL=jdbc:mysql://localhost:3306/tekwatt_charging_sessions?serverTimezone=UTC
