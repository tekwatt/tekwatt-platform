# Android emulator reaches the Windows host through 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Optional: enables self-registration into a specific workspace.
EXPO_PUBLIC_DEFAULT_TENANT_ID=

# HTTPS customer web portal for invoice payment links/QR. Rebuild after changing.
EXPO_PUBLIC_CUSTOMER_PORTAL_URL=

# Required for Google Maps in a standalone Android APK (not needed in Expo Go).
# Restrict this key to the Android package in.tekwatt.nexus and its signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
